FROM willowgod/artalk:latest

# The Upgit release binary is a glibc Linux executable. The upstream final image
# is Alpine/musl, so install compatibility plus compiler-runtime libraries or
# the loader reports missing libgcc_s/_Unwind symbols.
RUN apk add --no-cache gcompat libgcc libstdc++

COPY upgit /usr/bin/upgit
RUN chmod 0755 /usr/bin/upgit
