FROM rust:1-alpine AS upgit-builder

RUN apk add --no-cache musl-dev git ca-certificates

ARG UPGIT_REPO=https://github.com/pluveto/upgit
ARG UPGIT_TAG=master

RUN git clone --depth 1 --branch "${UPGIT_TAG}" "${UPGIT_REPO}" /src

WORKDIR /src

RUN cargo build --release -p upgit

FROM willowgod/artalk:latest

RUN apk add --no-cache bash tzdata

COPY --from=upgit-builder /src/target/release/upgit /usr/bin/upgit
RUN chmod 0755 /usr/bin/upgit